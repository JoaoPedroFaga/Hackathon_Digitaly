generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adm {
  cpf                    String   @id @db.VarChar(11)
  email                  String
  senha                  String
  medico_medico_admToadm medico[] @relation("medico_admToadm")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cliente {
  cpf                                  String      @id @db.VarChar(11)
  nome                                 String
  sobrenome                            String
  tel                                  String      @db.VarChar(11)
  sexo                                 Int
  email                                String
  senha                                String
  estado                               String
  cidade                               String
  rua                                  String
  numero                               String
  nascimento                           String      @db.VarChar(10)
  complemento                          String?
  consultas_consultas_clienteTocliente consultas[] @relation("consultas_clienteTocliente")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model medico {
  crm                                String      @db.VarChar(7)
  crm_estado                         String      @db.VarChar(2)
  cpf                                String      @unique @db.VarChar(11)
  nome                               String
  sobrenome                          String
  email                              String
  senha                              String
  adm                                String      @db.VarChar(11)
  consultas_consultas_medicoTomedico consultas[] @relation("consultas_medicoTomedico")
  adm_medico_admToadm                adm         @relation("medico_admToadm", fields: [adm], references: [cpf], onDelete: NoAction, onUpdate: NoAction)

  @@id([crm, crm_estado])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model consultas {
  id                                 Int     @id @default(autoincrement())
  cliente                            String  @db.VarChar(11)
  medico                             String  @db.VarChar(11)
  data                               String  @db.VarChar(10)
  hora                               String  @db.VarChar(5)
  motivo                             String
  sintomas                           String?
  medicacao                          String?
  piora                              String?
  obs                                String?
  relatorio                          String?
  cliente_consultas_clienteTocliente cliente @relation("consultas_clienteTocliente", fields: [cliente], references: [cpf], onDelete: NoAction, onUpdate: NoAction)
  medico_consultas_medicoTomedico    medico  @relation("consultas_medicoTomedico", fields: [medico], references: [cpf], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliente, data, hora], map: "cli")
  @@unique([medico, data, hora], map: "med")
}
